    "kb_article": [
      {
        "kb_id": "K-1001",
        "policy_type": "refund",
        "title": "退款政策：申请条件与到账时效",
        "body": "未发货订单可全额退款，审核通过后 3 个工作日退回原支付渠道；已发货订单需先拦截或签收后退回，退款在签收后 7 个工作日内处理；退款申请被拒时须说明原因并给客户留申诉入口。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      },
      {
        "kb_id": "K-1002",
        "policy_type": "cancel",
        "title": "取消订单规则：未发货与已发货的区别",
        "body": "未发货订单可即时取消并原路退回；已发货订单不能直接取消，只能走拦截或拒收流程；取消与退款是两步，取消成功不等于退款到账。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      },
      {
        "kb_id": "K-1003",
        "policy_type": "warranty",
        "title": "商品保修政策：整机与配件",
        "body": "整机保修 12 个月，配件保修 3 个月，自签收之日起算；保修需提供订单号与签收凭证；人为损坏、进液、私自拆修不在保修范围；保修期内非人为故障免费维修，超过 30 天未修复可申请换新。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      },
      {
        "kb_id": "K-1004",
        "policy_type": "logistics",
        "title": "物流异常处理与赔付标准",
        "body": "物流延迟超过 72 小时按每天 20 元赔付，单笔上限 100 元；包裹丢失按实付金额全额赔付；物流异常需先核实承运商轨迹与异常标记，再决定赔付或补发，不能只看客户描述就承诺赔付。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      },
      {
        "kb_id": "K-1005",
        "policy_type": "sla",
        "title": "工单响应时效与超时升级（SLA）",
        "body": "普通工单 6 小时内首次响应；临近超时（2 小时内到期）须优先响应并升级；超时未响应由值班主管跟进，加急工单需在 1 小时内给出结论。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      },
      {
        "kb_id": "K-1006",
        "policy_type": "missing_order",
        "title": "缺少订单号时的处理规范",
        "body": "客户未提供订单号且无法定位时，先按客户账号维度检索；仍无法定位则请客户补充订单号或下单手机号，不得凭猜测指定订单，也不得据此承诺退款或赔付。",
        "version": "v1",
        "status": "PUBLISHED",
        "updated_at": "2026-09-01 12:00:00"
      }
    ]
